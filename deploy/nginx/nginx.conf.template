load_module modules/ngx_nchan_module.so;

worker_processes auto;
worker_rlimit_nofile 65536;
pid /run/nginx.pid;
error_log /var/log/nginx/error.log warn;

events {
    worker_connections 10240;
    multi_accept on;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Never log the query string: WebSocket tokens travel there.
    log_format demo '$remote_addr [$time_local] "$request_method $uri" '
                    '$status $body_bytes_sent rt=$request_time';
    access_log /var/log/nginx/access.log demo;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    client_max_body_size 1m;

    resolver 127.0.0.11 valid=10s ipv6=off;

    nchan_shared_memory_size 64m;

    upstream app {
        server @NODE@-app:8080;
        keepalive 32;
    }

    server {
        listen 80;
        server_name _;

        root /usr/share/nginx/html;
        index index.html;

        location / {
            try_files $uri $uri/ /index.html;
        }

        location = /healthz {
            proxy_pass http://app/healthz;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
        }

        # auth_request subrequest: validates the token and registers the
        # user's presence. The response header becomes $auth_user.
        location = /_auth {
            internal;
            proxy_pass http://app/internal/auth;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # One socket per user, one Nchan channel per user. Nchan owns the
        # connection from here on; Go is never in the data path.
        location = /ws {
            if ($http_upgrade != "websocket") {
                return 426;
            }

            auth_request /_auth;
            auth_request_set $auth_user $upstream_http_x_user_id;
            auth_request_set $auth_error $upstream_status;

            nchan_subscriber;
            nchan_channel_id "u:$auth_user";
            nchan_message_buffer_length 50;
            nchan_message_timeout 60s;
        }

        # Local publish endpoint, reachable only from the Docker network.
        # The Go bridge POSTs here after receiving a Redis fan-out message.
        location ~ ^/internal/pub/(.+)$ {
            allow 127.0.0.1;
            allow 10.0.0.0/8;
            allow 172.16.0.0/12;
            allow 192.168.0.0/16;
            deny all;

            # Defense in depth: the bridge must present the shared secret.
            if ($http_x_publisher_token != "@INTERNAL_TOKEN@") {
                return 403;
            }

            nchan_publisher;
            nchan_channel_id $1;
        }

        location /api/ {
            proxy_pass http://app;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
    }
}
